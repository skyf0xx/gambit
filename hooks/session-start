#!/usr/bin/env bash
# SessionStart hook for the Gambit plugin.
#
# Restores the silent GOAL.json preload that AGENTS.md requires but that the
# legacy `gambit init` installer never propagated (it only injects a
# skills-list stanza into the project's own AGENTS.md). This hook resolves
# the active goal per the precedence rule in skills/_shared/RESOLVING.md
# and, when one exists, injects its title/focus/last log line/deadline plus
# the four "Guided, not just capable" rules — the parts of AGENTS.md that a
# session outside this repo would otherwise never see.
#
# It also checks whether the installed plugin is behind the marketplace it
# came from (see plugin_update_notice below) and, if so, prepends a short
# notice to the same context blob — so the update check never needs a
# second hook registration or a second block of output-format branching.
#
# Must exit 0. Must stay silent when no goal resolves AND no update is
# available.

set -euo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$PWD}"
STORE_ROOT="${GAMBIT_HOME:-${XDG_DATA_HOME:+$XDG_DATA_HOME/gambit}}"
STORE_ROOT="${STORE_ROOT:-$HOME/.gambit}"

# --- resolve GOAL.json per skills/_shared/RESOLVING.md ---
GOAL_MD=""
if [ -f "${PROJECT_DIR}/GOAL.json" ]; then
    GOAL_MD="${PROJECT_DIR}/GOAL.json"
elif [ -f "${STORE_ROOT}/active" ]; then
    slug="$(tr -d '\r\n' < "${STORE_ROOT}/active")"
    if [ -n "$slug" ] && [ -f "${STORE_ROOT}/goals/${slug}/GOAL.json" ]; then
        GOAL_MD="${STORE_ROOT}/goals/${slug}/GOAL.json"
    fi
elif [ -d "${STORE_ROOT}/goals" ]; then
    # Exactly-one-goal case (resolution case 3). This hook only reads — it
    # does not write ~/.gambit/active, since that's the CLI/skill's job the
    # next time a skill actually resolves the goal; the hook just needs to
    # know what a session would see.
    count=0
    only=""
    for d in "${STORE_ROOT}"/goals/*/; do
        [ -f "${d}GOAL.json" ] || continue
        count=$((count + 1))
        only="${d}GOAL.json"
    done
    if [ "$count" -eq 1 ]; then
        GOAL_MD="$only"
    fi
fi

# --- plugin update check ---
# Is the installed plugin behind the marketplace it came from?
#
# Entirely local: the marketplace is a git clone Claude Code already
# maintains at ~/.claude/plugins/marketplaces/<name>, so comparing the
# manifest version there against the installed one costs no network call
# and cannot hang a session start. Only applies to a marketplace install
# (CLAUDE_PLUGIN_ROOT under .../plugins/cache/<marketplace>/<plugin>/<version>)
# — a per-project `gambit init` copy has no such path and this stays silent.
UPDATE_NOTICE=""
plugin_update_notice() {
    [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] || return 0
    command -v git >/dev/null 2>&1 || return 0

    local plugins_root marketplace installed_version clone branch manifest latest
    plugins_root="${CLAUDE_PLUGIN_ROOT%/cache/*}"
    [ "$plugins_root" != "$CLAUDE_PLUGIN_ROOT" ] || return 0
    installed_version="$(basename "$CLAUDE_PLUGIN_ROOT")"
    marketplace="${CLAUDE_PLUGIN_ROOT#"${plugins_root}"/cache/}"
    marketplace="${marketplace%%/*}"

    clone="${plugins_root}/marketplaces/${marketplace}"
    [ -d "${clone}/.git" ] || return 0

    # Read the manifest from the tracked remote branch, not the working
    # tree — the working tree is whatever was last pulled, so a published
    # update is invisible there until the host happens to refresh it.
    branch="$(git -C "$clone" symbolic-ref --quiet --short HEAD 2>/dev/null || echo master)"
    manifest="$(git -C "$clone" show "origin/${branch}:.claude-plugin/marketplace.json" 2>/dev/null)"
    [ -n "$manifest" ] || return 0

    latest="$(printf '%s\n' "$manifest" \
        | sed -n '/"name"[[:space:]]*:[[:space:]]*"gambit"/,/}/p' \
        | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    [ -n "$latest" ] || return 0
    [ "$latest" != "$installed_version" ] || return 0
    [ "$installed_version" != "unknown" ] || return 0

    # sort -V decides direction: report only when the marketplace is ahead,
    # never when a locally-built plugin is ahead of it.
    [ "$(printf '%s\n%s\n' "$installed_version" "$latest" | sort -V | tail -1)" = "$latest" ] || return 0

    # Two steps, and the qualified plugin@marketplace id in the second —
    # `claude plugin update` resolves its argument as that id, and it only
    # offers a version the marketplace clone has already fetched.
    UPDATE_NOTICE="A newer version of Gambit is available (${installed_version} -> ${latest}). If the user wants to update, run: claude plugin marketplace update ${marketplace} && claude plugin update gambit@${marketplace} (takes effect on restart). Mention this once; don't repeat it later in the session."
}
plugin_update_notice || true

# Refresh the remote ref the check above reads, for the next session rather
# than this one. Fully detached and discarded: a session start must never
# wait on the network, so this session reports against whatever was already
# fetched and the fetch it kicks off lands in time for the next one.
refresh_marketplace_ref() {
    [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] || return 0
    command -v git >/dev/null 2>&1 || return 0
    local plugins_root marketplace clone
    plugins_root="${CLAUDE_PLUGIN_ROOT%/cache/*}"
    [ "$plugins_root" != "$CLAUDE_PLUGIN_ROOT" ] || return 0
    marketplace="${CLAUDE_PLUGIN_ROOT#"${plugins_root}"/cache/}"
    marketplace="${marketplace%%/*}"
    clone="${plugins_root}/marketplaces/${marketplace}"
    [ -d "${clone}/.git" ] || return 0
    ( git -C "$clone" fetch --quiet origin >/dev/null 2>&1 & ) >/dev/null 2>&1
}
refresh_marketplace_ref || true

[ -n "$GOAL_MD" ] || [ -n "$UPDATE_NOTICE" ] || exit 0

# JSON-escape via bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

emit_context() {
    local escaped
    escaped=$(escape_for_json "$1")

    if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
        printf '{
  "additional_context": "%s"
}
' "$escaped"
    elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
        printf '{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "%s"
  }
}
' "$escaped"
    else
        printf '{
  "additionalContext": "%s"
}
' "$escaped"
    fi
}

goal_context=""
if [ -n "$GOAL_MD" ]; then
    # --- pull title / focus / deadline / last log summary out of GOAL.json ---
    # Structured reads via the same Zod schema every other reader validates
    # through (safeParseGoalJson), rather than text-scanning Markdown. Runs
    # as a subprocess so a bad/invalid file can't crash this hook under
    # `set -euo pipefail` — output is captured defensively with `|| true`
    # and empty output falls back to the same placeholder text as before.
    # Resolved to an absolute path (via node itself, portably) because
    # $0's directory is relative to the invoker's cwd, not this script's
    # location — and a relative specifier passed to dynamic import() below
    # resolves against the node process's cwd, not the script on disk.
    SCHEMA_MJS="$(cd "$(dirname "$0")/.." >/dev/null 2>&1 && pwd)/src/store/schema.mjs"

    goal_fields="$(node -e '
        import(process.argv[1]).then(async ({ safeParseGoalJson }) => {
            const fs = await import("node:fs");
            let raw;
            try {
                raw = fs.readFileSync(process.argv[2], "utf8");
            } catch {
                process.exit(1);
            }
            const result = safeParseGoalJson(raw);
            if (!result.success) process.exit(1);
            const goal = result.data;

            const title = goal.goal;
            const deadline = goal.deadline ?? "none";
            const focus = [...goal.log].reverse().find((e) => e.focus)?.focus ?? "nothing set yet";

            let lastLog = "no log entries yet";
            if (goal.log.length) {
                const entry = goal.log[goal.log.length - 1];
                lastLog = `${entry.date} ${entry.assessment ?? ""}`.trim();
                if (entry.notes && entry.notes.length) lastLog += ` — ${entry.notes[0]}`;
            }

            console.log(title);
            console.log(deadline);
            console.log(focus);
            console.log(lastLog);
        }).catch(() => process.exit(1));
    ' "$SCHEMA_MJS" "$GOAL_MD" 2>/dev/null || true)"

    title="$(printf '%s\n' "$goal_fields" | sed -n '1p')"
    deadline="$(printf '%s\n' "$goal_fields" | sed -n '2p')"
    focus="$(printf '%s\n' "$goal_fields" | sed -n '3p')"
    last_log="$(printf '%s\n' "$goal_fields" | sed -n '4p')"

    [ -n "$title" ] || title="(untitled goal)"
    [ -n "$deadline" ] || deadline="none"
    [ -n "$focus" ] || focus="nothing set yet"
    [ -n "$last_log" ] || last_log="no log entries yet"

    read -r -d '' goal_context <<CTX || true
# Active goal (Gambit)

GOAL: ${title}
FOCUS: ${focus}
LAST LOG: ${last_log}
DEADLINE: ${deadline}

This is silent context-loading, not a skill invocation — don't narrate having
read this, don't run \`onboard\` or \`strategy\` unprompted, and don't treat it
as a green light to take action. It exists so you already know the goal,
focus, and last log entry the moment the user says anything.

Four rules govern every Gambit skill and apply to this session generally when
acting on this goal:

**Elicit before committing.** Any skill that writes to GOAL.json shows the user
its read and asks what they think first, before a focus is locked in — one
exchange, then commit; a checkpoint, not a negotiation.

**Stay opinionated through pushback.** Elicitation surfaces facts a skill
couldn't see — it never becomes a way to hand the actual call to the user.
New information means re-reasoning to a new committed recommendation, not an
open "what would you do instead?" — except when the user is genuinely
holding an open choice between two live options themselves, which is
\`decide\`'s job.

**Always leave a next step.** No skill ends without naming the single most
useful next move plus a short menu of alternatives.

**Close on a decision, not a narrative.** When asked for a verdict, end with
the call itself — a committed answer, not just analysis of what happened.
CTX
fi

context_text="$UPDATE_NOTICE"
if [ -n "$goal_context" ]; then
    if [ -n "$context_text" ]; then
        context_text="${context_text}

${goal_context}"
    else
        context_text="$goal_context"
    fi
fi

emit_context "$context_text"

exit 0
